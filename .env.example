# ══════════════════════════════════════════════
#  انسخ هذا الملف إلى .env ثم املأ القيم
#  cp .env.example .env
#  ⚠️ لا ترفع ملف .env إلى GitHub أبداً
# ══════════════════════════════════════════════

# ---- تلجرام (إلزامي) ----
# من @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# معرف المحادثة/القناة: أرسل /id للبوت، أو استخدم @channelusername
TELEGRAM_CHAT_ID=

# ---- البورصة (اختياري: للإشارات فقط اتركها فارغة) ----
# مفاتيح Testnet من https://testnet.binancefuture.com
# صلاحية "تداول" فقط — بدون صلاحية سحب (Withdraw) أبداً
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ---- أمان التنفيذ الحقيقي ----
# اتركه فارغاً = Testnet إجبارياً.
# ضع true فقط بعد نجاح أسبوعين على Testnet + مراجعة قائمة التحقق في EXECUTION.md
ALLOW_LIVE=

# ---- تجاوز البورصة للاختبار السريع (اختياري) ----
# EXCHANGE=okx
